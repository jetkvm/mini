[mapping:tinyh264]
archive:libtinyh264.a
entries:
    if ESP_H264_DECODER_IRAM = y:
        h264bsd_reconstruct (noflash)
        h264bsd_cavlc (noflash)
        h264bsd_transform (noflash)
        h264bsd_vlc (noflash)
        h264bsd_stream (noflash)
        h264bsd_intra_prediction (noflash)
    else:
        * (default)

# Bound the encoder's setup/completion cost when network work evicts the
# instruction cache. This is a performance placement only: error logging and
# other callees may still use flash, so interrupt allocation stays unchanged.
[mapping:jetkvm_h264_hotpath]
archive:libespressif__esp_h264.a
entries:
    if IDF_TARGET_ESP32P4 = y:
        esp_h264_enc_single:esp_h264_enc_process (noflash)
        esp_h264_enc_param:esp_h264_enc_get_gop (noflash)
        esp_h264_enc_single_hw:enc_process (noflash)
        esp_h264_enc_single_hw:h264_hw_enc_gop_mode_process (noflash)
        esp_h264_enc_single_hw:h264_start_gop_mode_enc (noflash)
        esp_h264_enc_single_hw:h264_output_invalidate_size (noflash)
        esp_h264_enc_single_hw:h264_gop_isr (noflash)
        esp_h264_enc_hw_param:get_gop (noflash)
        esp_h264_enc_hw_param:cfg_dsc (noflash)
        esp_h264_enc_hw_param:esp_h264_enc_hw_get_mutex (noflash)
        esp_h264_enc_hw_param:esp_h264_enc_hw_take_force_idr (noflash)
        esp_h264_enc_hw_param:esp_h264_enc_hw_get_qp_init (noflash)
        esp_h264_enc_hw_param:esp_h264_enc_hw_get_nal (noflash)
        esp_h264_enc_hw_param:esp_h264_enc_hw_cfg_dma_yuv_bs (noflash)
        esp_h264_enc_hw_param:esp_h264_enc_hw_cfg_dma_mvm (noflash)
        esp_h264_enc_hw_param:esp_h264_enc_hw_set_qp (noflash)
        esp_h264_enc_hw_param:esp_h264_enc_hw_get_rc_hd (noflash)
        esp_h264_enc_hw_param:esp_h264_enc_hw_set_rc_rate_pred (noflash)
        esp_h264_enc_hw_param:esp_h264_enc_hw_get_mbres (noflash)
        esp_h264_enc_hw_param:esp_h264_enc_hw_set_pbyte (noflash)
        esp_h264_enc_hw_param:esp_h264_enc_hw_slice_header_align8 (noflash)
        esp_h264_cache (noflash)
        h264_hal (noflash)
        h264_dma_hal (noflash)
        h264_nal:bs_write_u1 (noflash)
        h264_nal:bs_write_ue (noflash)
        h264_nal:esp_h264_enc_hw_set_slice (noflash)
        h264_nal:i_size0_255 (noflash)
        h264_rc:esp_h264_rc_start (noflash)
        h264_rc:esp_h264_rc_end (noflash)
