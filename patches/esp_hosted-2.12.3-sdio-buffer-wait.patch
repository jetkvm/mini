+/* Hosted takes each SDIO buffer from the internal DMA heap, which a burst of
+ * other work (a new WebRTC peer, a TLS download) can leave without a free
+ * 1600-byte block for a moment. Wait for memory instead of asserting. The
+ * slave keeps a packet until the host reads it, so a receive loses nothing;
+ * a caller that holds the bus releases it meanwhile, so the other direction
+ * can send and free its buffers. A shortage that outlasts the wait still
+ * asserts in the caller. */
+#define SDIO_BUFFER_WAIT_MS 5000
+
+static void *sdio_alloc_waiting(void *(*alloc)(uint32_t len), uint32_t len,
+		bool holds_bus, const char *what)
+{
+	void *buf = alloc(len);
+	unsigned int waited_ms = 0;
+
+	while (!buf && waited_ms < SDIO_BUFFER_WAIT_MS) {
+		/* 10, 20, then 40 ms at a time */
+		const unsigned int sleep_ms = H_MIN(waited_ms + 10, 40);
+
+		if (holds_bus)
+			SDIO_DRV_UNLOCK();
+		g_h.funcs->_h_msleep(sleep_ms);
+		if (holds_bus)
+			SDIO_DRV_LOCK();
+		waited_ms += sleep_ms;
+		buf = alloc(len);
+	}
+	if (waited_ms)
+		ESP_LOGW(TAG, "no memory for an %s buffer for %u ms%s", what,
+				waited_ms, buf ? "" : ", giving up");
+	return buf;
+}
+
+static void *sdio_tx_buffer_alloc(uint32_t len)
+{
+	(void)len;
+	return sdio_buffer_alloc(MEMSET_REQUIRED);
+}
