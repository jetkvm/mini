+esp_err_t httpd_sess_arm_recv_timeout(httpd_handle_t handle, int sockfd)
+{
+    struct httpd_data *hd = (struct httpd_data *) handle;
+    if (hd == NULL || hd->hdr_deadline_us == 0 || hd->hdr_deadline_fd != sockfd) {
+        return ESP_OK;
+    }
+    int64_t left_us = hd->hdr_deadline_us - esp_timer_get_time();
+    if (left_us <= 0) {
+        return ESP_ERR_TIMEOUT;
+    }
+    int64_t wait_us = (int64_t) hd->config.recv_wait_timeout * 1000000;
+    if (wait_us == 0 || left_us < wait_us) {
+        wait_us = left_us;
+    }
+    /* lwIP counts whole milliseconds and takes 0 as no timeout */
+    int64_t wait_ms = (wait_us + 999) / 1000;
+    struct timeval tv = { .tv_sec = wait_ms / 1000, .tv_usec = (wait_ms % 1000) * 1000 };
+    if (setsockopt(sockfd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv)) < 0) {
+        return ESP_FAIL;
+    }
+    return ESP_OK;
+}
