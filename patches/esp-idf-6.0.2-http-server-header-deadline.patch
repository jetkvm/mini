+/* recv_wait_timeout limits each recv only. A client that sends a byte
+ * before each timeout keeps the loop in httpd_parse_req(), and with it the
+ * server task and all other sessions, busy until max_req_hdr_len is full.
+ * req_hdr_timeout_ms limits the request line and headers as a whole;
+ * httpd_sess_arm_recv_timeout() applies it to each recv. */
+static void hdr_deadline_start(struct httpd_data *hd)
+{
+    hd->hdr_deadline_us = 0;
+    if (hd->config.req_hdr_timeout_ms) {
+        hd->hdr_deadline_fd = hd->hd_req_aux.sd->fd;
+        hd->hdr_deadline_us = esp_timer_get_time() +
+                              (int64_t) hd->config.req_hdr_timeout_ms * 1000;
+    }
+}
+
+static bool hdr_deadline_over(const struct httpd_data *hd)
+{
+    return hd->hdr_deadline_us && esp_timer_get_time() >= hd->hdr_deadline_us;
+}
+
+static void hdr_deadline_stop(struct httpd_data *hd)
+{
+    if (!hd->hdr_deadline_us) {
+        return;
+    }
+    hd->hdr_deadline_us = 0;
+    /* The body and WebSocket frames keep recv_wait_timeout per recv */
+    struct timeval tv = { .tv_sec = hd->config.recv_wait_timeout, .tv_usec = 0 };
+    (void) setsockopt(hd->hdr_deadline_fd, SOL_SOCKET, SO_RCVTIMEO, &tv, sizeof(tv));
+}
