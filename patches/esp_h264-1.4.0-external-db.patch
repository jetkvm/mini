+/**
+ * @brief  Give the hardware encoder a de-blocking (DB) store that the caller owns
+ *
+ * @note  Every encoder created afterwards uses this store instead of allocating
+ *        its DB buffer, zeroes it when it is created and does not free it. One
+ *        encoder at a time can use the store. Call this before the encoder is
+ *        created; NULL and 0 go back to per-encoder allocation.
+ *
+ * @param[in]  buffer  Cache-aligned PSRAM of `size` bytes, or NULL
+ * @param[in]  size    At least the DB size of the largest resolution to encode
+ *
+ * @return
+ *       - ESP_H264_ERR_OK   Succeeded
+ *       - ESP_H264_ERR_ARG  Invalid arguments, or an encoder uses the store now
+ */
+esp_h264_err_t esp_h264_enc_hw_set_db_pool(void *buffer, size_t size);
+
 #ifdef __cplusplus
 }
 #endif
