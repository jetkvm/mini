@@ -59,6 +60,24 @@
 
 static esp_h264_param_t *s_reference_pool_owner;
 
+/* A caller-owned DB store that outlives the encoder. When it is set, opening
+ * an encoder takes it instead of allocating 1.4-3.1 MB of PSRAM, so a change
+ * of resolution neither frees nor requests that block again. */
+static uint8_t *s_db_pool;
+static size_t s_db_pool_size;
+static esp_h264_param_t *s_db_pool_owner;
+
+esp_h264_err_t esp_h264_enc_hw_set_db_pool(void *buffer, size_t size)
+{
+    ESP_H264_RET_ON_FALSE((buffer == NULL) == (size == 0U), ESP_H264_ERR_ARG,
+                          TAG, "Invalid DB pool");
+    ESP_H264_RET_ON_FALSE(__atomic_load_n(&s_db_pool_owner, __ATOMIC_ACQUIRE) == NULL,
+                          ESP_H264_ERR_ARG, TAG, "DB pool is in use");
+    s_db_pool = (uint8_t *)buffer;
+    s_db_pool_size = size;
+    return ESP_H264_ERR_OK;
+}
