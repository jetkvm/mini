 static sdmmc_card_t* s_cards[FF_VOLUMES] = { NULL };
 static bool s_disk_status_check_en[FF_VOLUMES] = { };
@@ -91,6 +95,75 @@ static DRESULT ff_sdmmc_trim (BYTE pdrv, DWORD start_sector, DWORD sector_count)
 }
 #endif //FF_USE_TRIM
 
+#if JETKVM_FATFS_SEQ_PREERASE
+static DRESULT ff_sdmmc_seq_preerase(BYTE pdrv,
+                                     const jetkvm_disk_range_t* request)
+{
+    sdmmc_card_t* card = s_cards[pdrv];
+    assert(card);
+
+    const uint64_t request_lba = request->start_lba;
+    const uint64_t request_count = request->sector_count;
+    const uint64_t capacity = (uint64_t)card->csd.capacity;
+    uint64_t erase_lba = request_lba;
+    uint64_t erase_count = 0;
+    esp_err_t result = ESP_ERR_NOT_SUPPORTED;
+    int64_t started_us = esp_timer_get_time();
+
+    /* This experiment deliberately excludes SDSPI, MMC, SDSC and cards that
+     * do not advertise the SD erase command class.  Requiring decoded SSR
+     * geometry also lets us align inward, so an erase unit containing a live
+     * cluster adjacent to the free extent is never selected. */
+    bool safe_native_sd = card->is_mem && !card->is_mmc &&
+            !(card->host.flags & SDMMC_HOST_FLAG_SPI) &&
+            (card->ocr & SD_OCR_SDHC_CAP) &&
+            card->csd.csd_ver == SD_CSD_CSDVER_2_0 &&
+            (card->csd.card_command_class & SD_CSD_CCC_ERASE) &&
+            card->csd.sector_size == 512 &&
+            card->ssr.alloc_unit_kb != 0 && card->ssr.erase_size_au != 0;
+    bool request_in_range = request_count != 0 && request_lba < capacity &&
+            request_count <= capacity - request_lba;
+
+    if (safe_native_sd && request_in_range) {
+        uint64_t erase_unit_sectors =
+                ((uint64_t)card->ssr.alloc_unit_kb * 1024U /
+                 (uint64_t)card->csd.sector_size) *
+                (uint64_t)card->ssr.erase_size_au;
+        uint64_t request_end = request_lba + request_count;
+        if (erase_unit_sectors != 0 &&
+                request_lba <= UINT64_MAX - (erase_unit_sectors - 1U)) {
+            erase_lba = ((request_lba + erase_unit_sectors - 1U) /
+                         erase_unit_sectors) * erase_unit_sectors;
+            uint64_t erase_end =
+                    (request_end / erase_unit_sectors) * erase_unit_sectors;
+            if (erase_end > erase_lba) {
+                erase_count = erase_end - erase_lba;
+                result = sdmmc_erase_sectors(card, (size_t)erase_lba,
+                                             (size_t)erase_count,
+                                             SDMMC_ERASE_ARG);
+            } else {
+                result = ESP_ERR_INVALID_SIZE;
+            }
+        } else {
+            result = ESP_ERR_INVALID_SIZE;
+        }
+    }
+
+    int64_t elapsed_us = esp_timer_get_time() - started_us;
+    ESP_LOGI(TAG,
+             "seq-preerase request_lba=%" PRIu64 " request_count=%" PRIu64
+             " lba=%" PRIu64 " count=%" PRIu64 " us=%" PRIi64
+             " result=0x%x",
+             request_lba, request_count, erase_lba, erase_count, elapsed_us,
+             (unsigned)result);
+    if (result == ESP_OK) {
+        return RES_OK;
+    }
+    return result == ESP_ERR_NOT_SUPPORTED || result == ESP_ERR_INVALID_SIZE ?
+            RES_PARERR : RES_ERROR;
+}
+#endif
+
 static DRESULT ff_sdmmc_ioctl (BYTE pdrv, BYTE cmd, void* buff)
 {
     sdmmc_card_t* card = s_cards[pdrv];
@@ -114,6 +187,10 @@ static DRESULT ff_sdmmc_ioctl (BYTE pdrv, BYTE cmd, void* buff)
             return ff_sdmmc_trim (pdrv, *((DWORD*)buff), //start_sector
                     (*((DWORD*)buff + 1) - *((DWORD*)buff) + 1)); //sector_count
 #endif //FF_USE_TRIM
+#if JETKVM_FATFS_SEQ_PREERASE
+        case CTRL_JETKVM_SD_SEQ_PREERASE:
+            return ff_sdmmc_seq_preerase(pdrv, (const jetkvm_disk_range_t*)buff);
+#endif
     }
     return RES_ERROR;
 }
