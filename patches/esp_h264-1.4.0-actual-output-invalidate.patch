 #include "esp_h264_enc_single_hw.h"
 #include "esp_h264_enc_hw_param.h"
 #include "esp_h264_intr_alloc.h"
+#include "esp_cache.h"
 
 static const char *TAG = "H264_ENC.HW";
 
+static uint32_t h264_output_invalidate_size(uint8_t *out_frame, uint32_t out_frame_size,
+                                            int out_frame_len, uint32_t coded_len,
+                                            bool bitstream_overflow)
+{
+    if (bitstream_overflow || out_frame_len < 0 ||
+            (uint32_t)out_frame_len > out_frame_size ||
+            coded_len > out_frame_size - (uint32_t)out_frame_len) {
+        return out_frame_size;
+    }
+
+    size_t cache_line_size = esp_cache_get_line_size_by_addr(out_frame);
+    if (cache_line_size == 0 || cache_line_size > UINT32_MAX ||
+            ((uintptr_t)out_frame % cache_line_size) != 0 ||
+            (out_frame_size % cache_line_size) != 0) {
+        return out_frame_size;
+    }
+
+    uint32_t valid_len = (uint32_t)out_frame_len + coded_len;
+    if (valid_len == 0) {
+        return out_frame_size;
+    }
+
+    uint32_t remainder = valid_len % (uint32_t)cache_line_size;
+    if (remainder != 0) {
+        uint32_t padding = (uint32_t)cache_line_size - remainder;
+        if (padding > out_frame_size - valid_len) {
+            return out_frame_size;
+        }
+        valid_len += padding;
+    }
+    return valid_len;
+}
