+/* Send the status line, the headers added with httpd_resp_set_hdr() and the
+ * blank line that ends the head in one send. Sending each field, separator
+ * and value on its own turns a response head into about thirty TCP segments
+ * once the application sets TCP_NODELAY, each one a round trip through the
+ * TCP/IP task. */
+static esp_err_t httpd_send_head(httpd_req_t *r, const char *first)
+{
+    struct httpd_req_aux *ra = r->aux;
+    size_t first_len = strlen(first);
+    size_t size = first_len + 2;
+    for (unsigned i = 0; i < ra->resp_hdrs_count; i++) {
+        size += strlen(ra->resp_hdrs[i].field) + 2 + strlen(ra->resp_hdrs[i].value) + 2;
+    }
+    char *head = malloc(size);
+    if (head == NULL) {
+        ESP_LOGE(TAG, "Unable to allocate httpd response head buffer");
+        return ESP_ERR_HTTPD_ALLOC_MEM;
+    }
+    char *p = head;
+    memcpy(p, first, first_len);
+    p += first_len;
+    for (unsigned i = 0; i < ra->resp_hdrs_count; i++) {
+        size_t field_len = strlen(ra->resp_hdrs[i].field);
+        size_t value_len = strlen(ra->resp_hdrs[i].value);
+        memcpy(p, ra->resp_hdrs[i].field, field_len);
+        p += field_len;
+        memcpy(p, ": ", 2);
+        p += 2;
+        memcpy(p, ra->resp_hdrs[i].value, value_len);
+        p += value_len;
+        memcpy(p, "\r\n", 2);
+        p += 2;
+    }
+    memcpy(p, "\r\n", 2);
+    p += 2;
+    esp_err_t ret = httpd_send_all(r, head, (size_t)(p - head));
+    free(head);
+    return ret == ESP_OK ? ESP_OK : ESP_ERR_HTTPD_RESP_SEND;
+}
