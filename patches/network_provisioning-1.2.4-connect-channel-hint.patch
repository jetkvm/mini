+/* Start the connect scan on the channel where the last provisioning scan saw
+ * this SSID. With WIFI_FAST_SCAN (CONFIG_NETWORK_PROV_WIFI_STA_FAST_SCAN) the
+ * station then joins the first match instead of walking every channel of
+ * both bands first. That walk takes about 20 s on ESP-Hosted C5 with the DFS
+ * channels passive, and on a shared BLE/Wi-Fi radio the BLE link gets too
+ * little airtime for that long: the central's status reads stall and the
+ * link can hit its supervision timeout. esp_wifi documents the channel as
+ * where the scan starts, so an AP that has moved is still found. The caller
+ * keeps the configuration it reports to the application unchanged, so no
+ * hint is stored. */
+static void wifi_connect_channel_hint(wifi_sta_config_t *sta)
+{
+    if (sta->channel != 0 || sta->bssid_set) {
+        return;
+    }
+    /* A 32-byte SSID fills sta->ssid with no terminator; compare a copy
+     * sized like the scan records' SSID so the match stops at its end. */
+    uint8_t ssid[sizeof(((wifi_ap_record_t *)0)->ssid)] = {0};
+    memcpy(ssid, sta->ssid, sizeof(sta->ssid));
+    uint16_t used = scan_list_used();
+    uint16_t match = scan_list_find_ssid(ssid, used);
+    if (match == used) {
+        return;
+    }
+    sta->channel = prov_ctx->ap_list_sorted[match]->primary;
+    ESP_LOGI(TAG, "Connect scan starts on channel %u", sta->channel);
+}
+
 static void wifi_connect_timer_cb(void *arg)
 {
