+    srtp_hmac_esp_sha1_update_polled(&state->work, message, msg_octets);
+#else
     if (esp_sha1_update(&state->work, message, msg_octets) != 0) {
         return srtp_err_status_auth_fail;
     }
+#endif
     return srtp_err_status_ok;
 }
 
