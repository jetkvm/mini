+/* Block new commands before waiting for outstanding AXI accesses to drain.
+ * reset_avail is the hardware indication that toggling channel reset is safe.
+ * RX3 (motion vectors) and RX4 (bitstream) need the same protection as RX0..2;
+ * the old all-link-stop helper omitted both of those output destinations.
+ * TRM section 41.5.2.4: TX3, TX4 and RX5 share the RX5 reset controls.
+ * TX3/TX4 have no independent cmd_disable/reset_avail/reset bits: treating
+ * their reserved state bits as completion flags would always time out. */
+static bool h264_dma_stop_and_reset(h264_dma_hal_context_t *hal)
+{
+    h264_dma_dev_t *dma = hal->dev;
+    const int64_t deadline_us = esp_timer_get_time() + 20000;
+    for (uint8_t i = 0; i < H264_DMA_IN_OUT_CH_NUM; i++) {
+        dma->dma_in_ch[i].link_conf.inlink_stop = 1;
+        dma->dma_in_ch[i].conf0.in_cmd_disable = 1;
+        dma->dma_out_ch[i].link_conf.outlink_stop = 1;
+    }
+    for (uint8_t i = 0; i < 3; i++) {
+        dma->dma_out_ch[i].conf0.out_cmd_disable = 1;
+    }
+    dma->dma_in_ch5.conf0.in_cmd_disable = 1;
+    while (true) {
+        bool reset_safe = dma->dma_in_ch5.state.in_reset_avail;
+        for (uint8_t i = 0; i < H264_DMA_IN_OUT_CH_NUM; i++) {
+            reset_safe = reset_safe && dma->dma_in_ch[i].state.in_reset_avail;
+        }
+        for (uint8_t i = 0; i < 3; i++) {
+            reset_safe = reset_safe && dma->dma_out_ch[i].state.out_reset_avail;
+        }
+        if (reset_safe) {
+            break;
+        }
+        if (esp_timer_get_time() >= deadline_us) {
+            return false;
+        }
+        esp_rom_delay_us(1);
+    }
+    for (uint8_t i = 0; i < H264_DMA_IN_OUT_CH_NUM; i++) {
+        dma->dma_in_ch[i].conf0.in_rst = 1;
+        dma->dma_in_ch[i].conf0.in_rst = 0;
+        dma->dma_in_ch[i].conf0.in_cmd_disable = 0;
+    }
+    for (uint8_t i = 0; i < 3; i++) {
+        dma->dma_out_ch[i].conf0.out_rst = 1;
+        dma->dma_out_ch[i].conf0.out_rst = 0;
+        dma->dma_out_ch[i].conf0.out_cmd_disable = 0;
+    }
+    dma->dma_in_ch5.conf0.in_rst = 1;
+    dma->dma_in_ch5.conf0.in_rst = 0;
+    dma->dma_in_ch5.conf0.in_cmd_disable = 0;
+    return true;
+}
