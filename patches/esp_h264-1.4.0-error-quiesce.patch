--- /dev/null
+++ b/managed_components/espressif__esp_h264/test_apps/test_dma_quiesce_host.py
@@ -0,0 +1,124 @@
+#!/usr/bin/env python3
+"""Exercise the production DMA abort sequence with delayed/broken AXI drains."""
+from pathlib import Path
+import subprocess
+import tempfile
+
+root = Path(__file__).resolve().parents[1]
+source = (root / "hw/hal/esp32p4/h264_dma_hal.c").read_text()
+begin = source.index("static bool h264_dma_stop_and_reset(")
+end = source.index("uint32_t h264_dma_hal_get_bs_intr(", begin)
+production = source[begin:end]
+
+harness = r"""
+#include <assert.h>
+#include <stdbool.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <setjmp.h>
+#define H264_DMA_IN_OUT_CH_NUM 5
+typedef struct {
+    struct { int inlink_stop, outlink_stop; } link_conf;
+    struct { int in_cmd_disable, out_cmd_disable, in_rst, out_rst; } conf0;
+    struct { int in_reset_avail, out_reset_avail; } state;
+} channel_t;
+typedef struct { channel_t dma_in_ch[5], dma_out_ch[5], dma_in_ch5; } h264_dma_dev_t;
+typedef struct { h264_dma_dev_t *dev; } h264_dma_hal_context_t;
+static h264_dma_dev_t device;
+static int64_t fake_us;
+static int delay_calls, ready_after, stuck_channel;
+static jmp_buf abort_jump;
+static int64_t esp_timer_get_time(void) { return fake_us; }
+
+static void assert_commands_disabled(void)
+{
+    for (int i = 0; i < 5; ++i) {
+        assert(device.dma_in_ch[i].conf0.in_cmd_disable);
+        assert(device.dma_in_ch[i].link_conf.inlink_stop);
+        assert(device.dma_out_ch[i].conf0.out_cmd_disable == (i < 3));
+        assert(device.dma_out_ch[i].link_conf.outlink_stop);
+    }
+    assert(device.dma_in_ch5.conf0.in_cmd_disable);
+}
+
+static void set_available(void)
+{
+    for (int i = 0; i < 5; ++i) {
+        device.dma_in_ch[i].state.in_reset_avail = stuck_channel != i;
+        /* TRM 41.5.2.4: TX3/TX4 have no independent reset controls.
+         * Their reserved reset-available bits must stay zero, even idle. */
+        device.dma_out_ch[i].state.out_reset_avail =
+            i < 3 && stuck_channel != 5 + i;
+    }
+    device.dma_in_ch5.state.in_reset_avail = stuck_channel != 8;
+}
+
+static void esp_rom_delay_us(unsigned us)
+{
+    assert(us == 1);
+    assert_commands_disabled();
+    ++delay_calls;
+    /* Accelerate only the fake clock, preserving the production deadline. */
+    fake_us += 1000;
+    if (delay_calls >= ready_after) set_available();
+}
+
+static void test_abort(void)
+{
+    assert_commands_disabled();
+    longjmp(abort_jump, 1);
+}
+#define abort test_abort
+/* PRODUCTION */
+#undef abort
+
+static void setup(int stuck, int delay)
+{
+    memset(&device, 0, sizeof(device));
+    fake_us = 0;
+    delay_calls = 0;
+    stuck_channel = stuck;
+    ready_after = delay;
+    if (delay == 0) set_available();
+}
+
+int main(void)
+{
+    h264_dma_hal_context_t hal = { .dev = &device };
+    /* Normal drain and delayed drain both cover all channels, including the
+     * previously omitted RX3/RX4 and the shared TX3/TX4/RX5 reset group.
+     * Permanently zero reserved TX3/TX4 flags must not prevent success. */
+    for (int delay = 0; delay < 4; ++delay) {
+        setup(-1, delay);
+        h264_dma_hal_deinit(&hal);
+        assert(delay_calls == delay);
+        for (int i = 0; i < 5; ++i) {
+            assert(device.dma_in_ch[i].link_conf.inlink_stop);
+            assert(device.dma_out_ch[i].link_conf.outlink_stop);
+            assert(!device.dma_in_ch[i].conf0.in_cmd_disable);
+            assert(!device.dma_out_ch[i].conf0.out_cmd_disable);
+        }
+        assert(!device.dma_in_ch5.conf0.in_cmd_disable);
+    }
+    /* Every possible stuck channel must reach the finite deadline with all
+     * commands disabled; deinit must not return ownership to its caller. */
+    for (volatile int stuck = 0; stuck < 9; ++stuck) {
+        setup(stuck, 0);
+        if (setjmp(abort_jump) == 0) {
+            h264_dma_hal_deinit(&hal);
+            assert(!"deinit returned while DMA could still access memory");
+        }
+        assert(fake_us == 20000);
+        assert(delay_calls == 20);
+        assert_commands_disabled();
+    }
+    puts("H264 DMA quiesce: delayed completion, TX3/TX4 reserved bits and all 9 timeout groups PASS");
+}
+"""
+with tempfile.TemporaryDirectory(prefix="h264-quiesce-") as directory:
+    path = Path(directory)
+    (path / "test.c").write_text(harness.replace("/* PRODUCTION */", production))
+    subprocess.run(["cc", "-std=c11", "-Wall", "-Wextra", "-Werror", "-O2",
+                    str(path / "test.c"), "-o", str(path / "test")], check=True)
+    subprocess.run([str(path / "test")], check=True)
