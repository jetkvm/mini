+/** Runtime telemetry for the optional SD ACMD23 pre-erase hint experiment. */
+typedef struct {
+    bool enabled;
+    bool unsupported_latched;
+    uint32_t attempts;
+    uint32_t successes;
+    uint32_t unsupported;
+    uint32_t failures;
