+
+/**
+ * Globally enable or disable ACMD23 before native-SD multi-block writes.
+ *
+ * Disabled is the reset default. MMC, SPI-mode, and single-block writes are
+ * never affected. ESP_ERR_NOT_SUPPORTED is counted and latched as a fallback;
+ * all other command errors are returned to the write caller.
+ */
+void sdmmc_acmd23_set_enabled(bool enabled);
+
+/** Reset counters and the unsupported-card latch without changing enablement. */
+void sdmmc_acmd23_reset_stats(void);
+
+/** Copy an atomic-field snapshot of the ACMD23 experiment. */
+esp_err_t sdmmc_acmd23_get_stats(sdmmc_acmd23_stats_t *out_stats);
