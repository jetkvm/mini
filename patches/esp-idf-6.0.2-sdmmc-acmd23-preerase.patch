+static atomic_bool s_acmd23_enabled = ATOMIC_VAR_INIT(false);
+static atomic_bool s_acmd23_unsupported_latched = ATOMIC_VAR_INIT(false);
+static atomic_uint_least32_t s_acmd23_attempts = ATOMIC_VAR_INIT(0);
+static atomic_uint_least32_t s_acmd23_successes = ATOMIC_VAR_INIT(0);
+static atomic_uint_least32_t s_acmd23_unsupported = ATOMIC_VAR_INIT(0);
+static atomic_uint_least32_t s_acmd23_failures = ATOMIC_VAR_INIT(0);
+static atomic_uint_least32_t s_acmd23_last_block_count = ATOMIC_VAR_INIT(0);
+static atomic_int_least32_t s_acmd23_last_error = ATOMIC_VAR_INIT(ESP_OK);
+
+void sdmmc_acmd23_set_enabled(bool enabled)
+{
+    atomic_store_explicit(&s_acmd23_enabled, enabled, memory_order_relaxed);
+}
+
+void sdmmc_acmd23_reset_stats(void)
+{
+    atomic_store_explicit(&s_acmd23_unsupported_latched, false,
+                          memory_order_relaxed);
+    atomic_store_explicit(&s_acmd23_attempts, 0, memory_order_relaxed);
+    atomic_store_explicit(&s_acmd23_successes, 0, memory_order_relaxed);
+    atomic_store_explicit(&s_acmd23_unsupported, 0, memory_order_relaxed);
+    atomic_store_explicit(&s_acmd23_failures, 0, memory_order_relaxed);
+    atomic_store_explicit(&s_acmd23_last_block_count, 0, memory_order_relaxed);
+    atomic_store_explicit(&s_acmd23_last_error, ESP_OK, memory_order_relaxed);
+}
+
+esp_err_t sdmmc_acmd23_get_stats(sdmmc_acmd23_stats_t *out_stats)
+{
+    if (out_stats == NULL) {
+        return ESP_ERR_INVALID_ARG;
+    }
+    *out_stats = (sdmmc_acmd23_stats_t) {
+        .enabled = atomic_load_explicit(&s_acmd23_enabled,
+                                        memory_order_relaxed),
+        .unsupported_latched = atomic_load_explicit(
+            &s_acmd23_unsupported_latched, memory_order_relaxed),
+        .attempts = atomic_load_explicit(&s_acmd23_attempts,
+                                         memory_order_relaxed),
+        .successes = atomic_load_explicit(&s_acmd23_successes,
+                                          memory_order_relaxed),
+        .unsupported = atomic_load_explicit(&s_acmd23_unsupported,
+                                            memory_order_relaxed),
+        .failures = atomic_load_explicit(&s_acmd23_failures,
+                                         memory_order_relaxed),
+        .last_block_count = atomic_load_explicit(
+            &s_acmd23_last_block_count, memory_order_relaxed),
+        .last_error = atomic_load_explicit(&s_acmd23_last_error,
+                                           memory_order_relaxed),
+    };
+    return ESP_OK;
+}
+
+static esp_err_t sdmmc_send_acmd23_preerase(sdmmc_card_t *card,
+                                             size_t block_count)
+{
+    if (!atomic_load_explicit(&s_acmd23_enabled, memory_order_relaxed) ||
+        atomic_load_explicit(&s_acmd23_unsupported_latched,
+                             memory_order_relaxed)) {
+        return ESP_OK;
+    }
+
+    atomic_fetch_add_explicit(&s_acmd23_attempts, 1, memory_order_relaxed);
+    atomic_store_explicit(
+        &s_acmd23_last_block_count,
+        block_count > UINT32_MAX ? UINT32_MAX : (uint32_t)block_count,
+        memory_order_relaxed);
+    if (block_count > SD_APP_SET_WR_BLK_ERASE_COUNT_MAX) {
+        atomic_fetch_add_explicit(&s_acmd23_failures, 1,
+                                  memory_order_relaxed);
+        atomic_store_explicit(&s_acmd23_last_error, ESP_ERR_INVALID_SIZE,
+                              memory_order_relaxed);
+        return ESP_ERR_INVALID_SIZE;
+    }
+
+    sdmmc_command_t cmd = {
+        .opcode = SD_APP_SET_WR_BLK_ERASE_COUNT,
+        .arg = (uint32_t)block_count,
+        .flags = SCF_CMD_AC | SCF_RSP_R1,
+    };
+    esp_err_t err = sdmmc_send_app_cmd(card, &cmd);
+    atomic_store_explicit(&s_acmd23_last_error, err, memory_order_relaxed);
+    if (err == ESP_OK) {
+        atomic_fetch_add_explicit(&s_acmd23_successes, 1,
+                                  memory_order_relaxed);
+        return ESP_OK;
+    }
+    if (err == ESP_ERR_NOT_SUPPORTED) {
+        atomic_fetch_add_explicit(&s_acmd23_unsupported, 1,
+                                  memory_order_relaxed);
+        atomic_store_explicit(&s_acmd23_unsupported_latched, true,
+                              memory_order_relaxed);
+        ESP_LOGW(TAG,
+                 "SD ACMD23 unsupported; continuing without pre-erase hints");
+        return ESP_OK;
+    }
+
+    atomic_fetch_add_explicit(&s_acmd23_failures, 1, memory_order_relaxed);
+    ESP_LOGE(TAG, "SD ACMD23 failed for %zu blocks: 0x%x", block_count, err);
+    return err;
+}
