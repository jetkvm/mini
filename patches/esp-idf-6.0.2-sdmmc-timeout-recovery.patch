+/**
+ * @brief Return the controller to idle after a transaction timed out
+ *
+ * Resets the controller, its DMA and its FIFO, drops queued events and reloads
+ * the card clock settings. The caller holds the controller mutex, so no other
+ * slot has a transaction in flight.
+ *
+ * @param[in] slot       SD Host Slot handle of the transaction that timed out
+ *
+ * @return
+ *        - ESP_OK:              On success
+ *        - ESP_ERR_TIMEOUT:     The reset or the clock update did not complete
+ */
+esp_err_t sd_host_recover(sd_host_sdmmc_slot_t *slot);
+
 /*---------------------------------------------------------------
                 Configuration APIs
 ---------------------------------------------------------------*/
