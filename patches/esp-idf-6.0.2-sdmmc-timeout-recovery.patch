+/* After a timed-out CMD53 the SDIO card can still be inside its data phase,
+ * where it does not answer the next CMD53. Writing the function number to the
+ * I/O abort register (CCCR 0x06) with CMD52 ends that transfer.
+ */
+static void abort_sdio_transfer(sd_host_sdmmc_slot_t *slot, const sdmmc_command_t *cmd)
+{
+    uint32_t func = (cmd->arg >> SD_ARG_CMD53_FUNC_SHIFT) & SD_ARG_CMD53_FUNC_MASK;
+    sdmmc_hw_cmd_t hw_cmd = {
+        .cmd_index = SD_IO_RW_DIRECT,
+        .response_expect = 1,
+        .check_response_crc = 1,
+        .stop_abort_cmd = 1,
+    };
+    uint32_t arg = SD_ARG_CMD52_WRITE | (SD_IO_CCCR_CTL << SD_ARG_CMD52_REG_SHIFT) | func;
+    uint32_t status = 0;
+    esp_err_t err = sd_host_slot_start_command(slot, hw_cmd, arg);
+    // A response error and CMD_DONE can come in separate events.
+    while (err == ESP_OK && !(status & SDMMC_INTMASK_CMD_DONE)) {
+        sd_host_sdmmc_event_t event = {};
+        err = sd_host_wait_for_event(slot, cmd->timeout_ms / portTICK_PERIOD_MS, &event);
+        status |= event.sdmmc_status;
+    }
+    if (err != ESP_OK || (status & SD_CMD_ERR_MASK)) {
+        ESP_LOGE(TAG, "SDIO abort of function %"PRIu32" failed: 0x%x, status %08"PRIx32, func, err, status);
+    }
+}
+
+/* Return the controller, and an SDIO card inside a CMD53, to idle after a timeout. */
+static void recover_transaction(sd_host_sdmmc_slot_t *slot, const sdmmc_command_t *cmd)
+{
+    slot->ctlr->is_app_cmd = false;
+    if (sd_host_recover(slot) == ESP_OK && cmd->opcode == SD_IO_RW_EXTENDED) {
+        abort_sdio_transfer(slot, cmd);
+    }
+}
