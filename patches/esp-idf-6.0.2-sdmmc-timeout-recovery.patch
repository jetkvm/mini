 }
 
+esp_err_t sd_host_recover(sd_host_sdmmc_slot_t *slot)
+{
+    sd_host_sdmmc_ctlr_t *ctlr = slot->ctlr;
+    sdmmc_dev_t *dev = ctlr->hal.dev;
+    ESP_LOGW(TAG, "slot %d: transaction timed out, resetting the controller "
+             "(status=%08"PRIx32" rintsts=%08"PRIx32" idsts=%08"PRIx32" lost events=%"PRIu32")",
+             slot->slot_id, dev->status.val, dev->rintsts.val, dev->idsts.val, ctlr->lost_events);
+    // Stop the DMA first, so that it cannot refill the FIFO after the reset.
+    sdmmc_ll_stop_dma(dev);
+    ESP_RETURN_ON_ERROR(sd_host_reset(ctlr), TAG, "controller reset timed out");
+    // Drop what the abandoned transaction left behind. SDIO card interrupts are
+    // not part of it and stay pending.
+    sdmmc_ll_clear_interrupt(dev, SDMMC_LL_SD_EVENT_MASK);
+    sdmmc_ll_clear_idsts_interrupt(dev, sdmmc_ll_get_idsts_interrupt_raw(dev));
+    xQueueReset(ctlr->event_queue);
+    sdmmc_ll_init_dma(dev);
+    // The controller reset also clears the clock settings the card interface had loaded.
+    return sd_host_slot_clock_update_command(slot, false);
+}
