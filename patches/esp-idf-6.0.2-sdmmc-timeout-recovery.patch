+/* Bench test of the timeout recovery (CONFIG_SD_HOST_SDMMC_FAULT_INJECT_PERIOD_S):
+ * once per period, the next CMD53 write runs without DMA. Its
+ * data phase never completes, as when a transfer stalls, and the transaction
+ * times out. Returns true when it has set up such a write.
+ */
+static bool inject_stall(sd_host_sdmmc_slot_t *slot, const sdmmc_command_t *cmd)
+{
+#if CONFIG_SD_HOST_SDMMC_FAULT_INJECT_PERIOD_S
+    static int64_t s_next_us;
+    int64_t now_us = esp_timer_get_time();
+    if (cmd->opcode != SD_IO_RW_EXTENDED || (cmd->flags & SCF_CMD_READ) || now_us < s_next_us) {
+        return false;
+    }
+    bool first = s_next_us == 0;
+    s_next_us = now_us + CONFIG_SD_HOST_SDMMC_FAULT_INJECT_PERIOD_S * 1000000LL;
+    if (first) {
+        return false;
+    }
+    ESP_LOGW(TAG, "fault injection: %d-byte CMD53 write on slot %d runs without DMA", (int)cmd->datalen, slot->slot_id);
+    sdmmc_ll_set_data_transfer_len(slot->ctlr->hal.dev, cmd->datalen);
+    sdmmc_ll_set_block_size(slot->ctlr->hal.dev, cmd->blklen);
+    sd_host_dma_stop(slot);
+    return true;
+#else
+    return false;
+#endif
+}
