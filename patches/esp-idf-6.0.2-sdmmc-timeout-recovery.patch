--- a/components/esp_driver_sdmmc/src/sd_host_sdmmc.c
+++ b/components/esp_driver_sdmmc/src/sd_host_sdmmc.c
@@ -814,6 +814,11 @@
         dma_pending &= ~(SDMMC_LL_EVENT_DMA_NI | SDMMC_LL_EVENT_DMA_TI | SDMMC_LL_EVENT_DMA_RI);
     }
     event.dma_status = dma_pending & SDMMC_LL_EVENT_DMA_MASK;
+    // This handler is the only producer, so a full queue loses this event and
+    // its transaction times out; sd_host_recover() reports the count.
+    if ((pending != 0 || dma_pending != 0) && xQueueIsQueueFullFromISR(ctlr->event_queue)) {
