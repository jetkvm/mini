+/* A browser keeps a connection that it opened ahead of a request for about
+ * this long before it drops it unused. */
+#define HTTPD_UNUSED_SESSION_MS 10000
+
+/* A request has reached the session but has no answer yet: its bytes wait in
+ * the socket or in the session's buffers. */
+static bool httpd_sess_unanswered(struct httpd_data *hd, struct sock_db *session)
+{
+    char byte;
+    return httpd_sess_pending(hd, session) ||
+           recv(session->fd, &byte, 1, MSG_PEEK | MSG_DONTWAIT) > 0;
+}
+
+/* The LRU purge may close only an idle session that has answered a request.
+ * A page opens a connection per asset, and each keeps the counter of its
+ * accept while the server, which answers one request at a time, works
+ * through the others; by counter alone it goes before any keep-alive
+ * session that a poller refreshes. Closed with its request unread, or before
+ * the browser has sent it, the request fails, and Chromium does not retry a
+ * connection that it has never used. A session that never sends a request
+ * may go once a browser would have dropped it. */
+static bool httpd_sess_idle(struct httpd_data *hd, struct sock_db *session)
+{
+    if (session->for_async_req || httpd_sess_unanswered(hd, session)) {
+        return false;
+    }
+    return session->answered ||
+           xTaskGetTickCount() - session->accept_tick >= pdMS_TO_TICKS(HTTPD_UNUSED_SESSION_MS);
+}
+
+#ifdef CONFIG_HTTPD_WS_SUPPORT
+typedef struct {
+    struct httpd_data *hd;
+    bool waits;
+} plain_wait_t;
+
+static int httpd_sess_note_plain_wait(struct sock_db *session, void *context)
+{
+    plain_wait_t *wait = (plain_wait_t *) context;
+    if (session->fd == -1 || session->for_async_req || session->ws_handshake_done ||
+        httpd_sess_idle(wait->hd, session)) {
+        return 1;
+    }
+    wait->waits = true;
+    return 0;
+}
+#endif
+
+/* A WebSocket carries a signaling session for as long as the page is open,
+ * while a plain session that may not go yet frees its slot once its request
+ * is answered or its browser drops it: the purge waits for that rather than
+ * close the WebSocket. */
+static bool httpd_sess_purgeable(struct httpd_data *hd, struct sock_db *session)
+{
+#ifdef CONFIG_HTTPD_WS_SUPPORT
+    if (session->ws_handshake_done) {
+        plain_wait_t wait = { .hd = hd, .waits = false };
+        if (!httpd_sess_idle(hd, session)) {
+            return false;
+        }
+        httpd_sess_enum(hd, httpd_sess_note_plain_wait, &wait);
+        return !wait.waits;
+    }
+#endif
+    return httpd_sess_idle(hd, session);
+}
