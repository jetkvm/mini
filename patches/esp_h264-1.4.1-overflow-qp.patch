+/* A frame that does not fit the output buffer never reaches esp_h264_rc_end(),
+ * so without this the next IDR starts from the same QP and overflows again
+ * for as long as the picture stays as detailed. Six QP steps halve the bits. */
+#define RC_OVERFLOW_QP_STEP 6
+
+uint8_t esp_h264_rc_overflow(esp_h264_rc_hd_t rc_hd)
+{
+    esp_h264_rc_t *prc = (esp_h264_rc_t *)rc_hd;
+    if (prc == NULL) {
+        return 0;
+    }
+    int qp_min = prc->qp_last + RC_OVERFLOW_QP_STEP;
+    if (qp_min > prc->qp_max) {
+        qp_min = prc->qp_max;
+    }
+    if (qp_min > prc->qp_min) {
+        prc->qp_min = (uint8_t)qp_min;
+    }
+    if (prc->qp_average_frame < prc->qp_min) {
+        prc->qp_average_frame = prc->qp_min;
+    }
+    prc->eqp = 0;
+    prc->err_sum = 0;
+    return prc->qp_min;
+}
+
+/* One QP step is about 12% more bits, so an IDR needs twelve steps to grow
+ * from a quarter of the buffer to all of it. An IDR coded six steps above an
+ * overflow uses more than half the buffer and keeps the raised minimum. */
+void esp_h264_rc_frame_fit(esp_h264_rc_hd_t rc_hd, bool is_iframe, uint32_t bytes, uint32_t capacity)
+{
+    esp_h264_rc_t *prc = (esp_h264_rc_t *)rc_hd;
+    if (prc == NULL || !is_iframe || prc->qp_min <= prc->qp_min_base) {
+        return;
+    }
+    if ((uint64_t)bytes * 4U <= capacity) {
+        prc->qp_min--;
+    }
+}
