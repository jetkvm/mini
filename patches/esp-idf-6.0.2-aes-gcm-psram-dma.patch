+/* Where the AES DMA path syncs the cache (ESP32-P4), esp_aes_process_dma_gcm()
+   takes buffers in DMA-capable PSRAM as esp_aes_process_dma() does. It does not
+   apply the 16-byte alignment that flash encryption and PSRAM ECC need for
+   external memory DMA, so with either one PSRAM buffers stay in software. */
+static bool esp_aes_gcm_dma_capable(const void *p)
+{
+#if SOC_CACHE_INTERNAL_MEM_VIA_L1CACHE && CONFIG_SPIRAM && SOC_PSRAM_DMA_CAPABLE && !CONFIG_SPIRAM_ECC_ENABLE
+    if (esp_ptr_dma_ext_capable(p) && !efuse_hal_flash_encryption_enabled()) {
+        return true;
+    }
+#endif
+    return esp_ptr_dma_capable(p);
+}
