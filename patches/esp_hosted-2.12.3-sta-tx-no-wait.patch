+ * reports ENOBUFS and the sender may try again. */
+static esp_err_t transport_tx_result(int sent)
+{
+	if (sent == ESP_OK)
+		return ESP_OK;
+#if defined(ESP_ERR_ESP_NETIF_TX_FAILED)
+	return ESP_ERR_ESP_NETIF_TX_FAILED;
+#else
+	return ESP_ERR_ESP_NETIF_NO_MEM;
+#endif
