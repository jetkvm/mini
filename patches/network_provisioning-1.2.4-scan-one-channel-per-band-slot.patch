+/* Non-DFS channels first: they are scanned actively (about 250 ms each) and
+ * carry phone hotspots, which avoid DFS. The DFS channels 52-144 are passive
+ * (about 740 ms each) and come last. */
+static const uint8_t scan_5g_channels[SCAN_SLOT_5G_COUNT] = {
+    36, 40, 44, 48, 149, 153, 157, 161, 165, 169, 173, 177,
+    52, 56, 60, 64,
+    100, 104, 108, 112, 116, 120, 124, 128, 132, 136, 140, 144,
+};
+
+/* Point scan_cfg at the single channel of one slot. */
+static void scan_slot_configure(uint16_t slot)
+{
+    prov_ctx->scan_cfg.channel = slot < SCAN_SLOT_5G_FIRST ?
+                                 slot : scan_5g_channels[slot - SCAN_SLOT_5G_FIRST];
+}
+
+/* The first slot of a request. A grouped request covers 2.4 GHz only, as
+ * before. A full request (channels_per_group == 0) walks the 5 GHz slots
+ * first and 2.4 GHz last: clients such as the setup page run a grouped
+ * 2.4 GHz pass before the full one, so 5 GHz networks are the new results. */
+static uint16_t scan_slot_first(void)
+{
+    return prov_ctx->channels_per_group ? 1 : SCAN_SLOT_5G_FIRST;
+}
+
+/* The slot after `slot` in the order scan_slot_first() starts, or 0 when the
+ * walk is complete. */
+static uint16_t scan_slot_next(uint16_t slot)
+{
+    if (slot >= SCAN_SLOT_5G_FIRST) {
+        return slot < SCAN_SLOT_COUNT - 1 ? slot + 1 : 1;
+    }
+    return slot < SCAN_SLOT_5G_FIRST - 1 ? slot + 1 : 0;
+}
+
+/* Entries appended so far; appends are contiguous from index 0. */
+static uint16_t scan_list_used(void)
+{
+    uint16_t used = 0;
+    while (used < MAX_SCAN_RESULTS && prov_ctx->ap_list_sorted[used]) {
+        used++;
+    }
+    return used;
+}
+
+/* Index of the entry that carries this SSID, or `used` when none does.
+ * Hidden networks (empty SSID) are never merged. */
+static uint16_t scan_list_find_ssid(const uint8_t *ssid, uint16_t used)
+{
+    if (ssid[0] == 0) {
+        return used;
+    }
+    for (uint16_t i = 0; i < used; i++) {
+        if (strncmp((const char *)prov_ctx->ap_list_sorted[i]->ssid,
+                    (const char *)ssid, sizeof(prov_ctx->ap_list_sorted[i]->ssid)) == 0) {
+            return i;
+        }
+    }
+    return used;
+}
