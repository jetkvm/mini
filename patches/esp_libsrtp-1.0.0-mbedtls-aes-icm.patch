+/* ESP-IDF's public CTR API switches RTP-sized requests to GDMA, where P4
+ * allocates packet-sized alignment buffers and descriptor lists.  libSRTP
+ * callbacks are serialized on the peer task, so hold the normal AES hardware
+ * lock once and run the same block transform without packet-time allocation. */
+static IRAM_ATTR int srtp_esp_aes_crypt_ctr_noalloc(
+    srtp_aes_icm_ctx_t *c,
+    const uint8_t *src,
+    size_t src_len,
+    uint8_t *dst)
+{
+    size_t n = c->nc_off;
+    size_t remaining = src_len;
+
+    while (n != 0 && remaining != 0) {
+        *dst++ = (uint8_t)(*src++ ^ c->stream_block.v8[n]);
+        n = (n + 1U) & 0x0fU;
+        remaining--;
+    }
+
+    if (remaining != 0) {
+        esp_aes_acquire_hardware();
+        c->ctx->key_in_hardware = 0;
+        c->ctx->key_in_hardware = aes_hal_setkey(
+            c->ctx->key, c->ctx->key_bytes, ESP_AES_ENCRYPT);
+        if (c->ctx->key_in_hardware != c->ctx->key_bytes) {
+            esp_aes_release_hardware();
+            memset(dst, 0, remaining);
+            return -1;
+        }
+
+        while (remaining != 0) {
+            if (n == 0) {
+                aes_hal_transform_block(c->counter.v8,
+                                        c->stream_block.v8);
+                for (int i = 15; i >= 0; i--) {
+                    if (++c->counter.v8[i] != 0) {
+                        break;
+                    }
+                }
+            }
+            *dst++ = (uint8_t)(*src++ ^ c->stream_block.v8[n]);
+            n = (n + 1U) & 0x0fU;
+            remaining--;
+        }
+        esp_aes_release_hardware();
+    }
+
+    c->nc_off = n;
+    return 0;
+}
+
