# One Mini under test. Copy to <name>.env (ignored by git) and pass <name> to
# tools/e2e/run.sh, tools/combined_load/run.sh or tools/e2e/serial_flash.sh.

# The Mini.
JETKVM_URL=http://192.168.1.100
# The board, for the firmware images: jetkvm-mini-ethernet or jetkvm-mini-wireless.
JETKVM_SKU=jetkvm-mini-ethernet
# SSH login of the Linux or macOS computer the Mini's USB and HDMI connect to.
# The tests run the remote agent there.
JETKVM_REMOTE_HOST=user@192.168.1.101

# Optional: the BuildKit service that builds the firmware images
# (tcp://<host>:<port> or an SSH login). Without it they build in this
# machine's Docker.
#JETKVM_BUILD_HOST=tcp://buildkit.example:1234
# Optional: the network a Wi-Fi Mini is put back on over BLE after an erase.
#JETKVM_WIFI_SSID="My network"
# Optional: the port and JWKS URL of the mock cloud on the Playwright machine.
#JETKVM_MOCK_CLOUD_PORT=8790
#JETKVM_MOCK_CLOUD_JWKS_URL=http://192.168.1.102:8790/oidc/jwks
