# ESP32-P4 host with an ESP32-C5-MINI module on FPC1.
CONFIG_ESP_WIFI_REMOTE_ENABLED=y
CONFIG_ESP_WIFI_REMOTE_LIBRARY_HOSTED=y
CONFIG_SLAVE_IDF_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_ENABLED=y
CONFIG_ESP_HOSTED_CP_TARGET_ESP32C5=y
CONFIG_ESP_HOSTED_P4_DEV_BOARD_NONE=y
CONFIG_ESP_HOSTED_SDIO_HOST_INTERFACE=y
CONFIG_ESP_HOSTED_SDIO_SLOT_1=y
CONFIG_ESP_HOSTED_SDIO_4_BIT_BUS=y
# Must match the embedded C5 firmware.
CONFIG_ESP_HOSTED_SDIO_OPTIMIZATION_RX_MAX_SIZE=y
# The mempool never returns freed SDIO buffers (internal DMA RAM) to the heap.
CONFIG_ESP_HOSTED_USE_MEMPOOL=n
# Each queued station frame holds a 1600-byte internal DMA buffer.
CONFIG_ESP_HOSTED_SDIO_TX_Q_SIZE=8
CONFIG_ESP_HOSTED_SDIO_CLOCK_FREQ_KHZ=40000
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CMD_SLOT_1=18
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_CLK_SLOT_1=19
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D0_SLOT_1=20
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D1_4BIT_BUS_SLOT_1=21
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D2_4BIT_BUS_SLOT_1=22
CONFIG_ESP_HOSTED_PRIV_SDIO_PIN_D3_4BIT_BUS_SLOT_1=23
CONFIG_ESP_HOSTED_SDIO_GPIO_RESET_SLAVE=9
CONFIG_ESP_HOSTED_SDIO_RESET_ACTIVE_HIGH=y
CONFIG_SERIAL_FLASHER_PORT_SDIO=y

# BLE host on the P4, HCI to the C5 controller over ESP-Hosted SDIO.
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BT_CONTROLLER_DISABLED=y
CONFIG_BT_NIMBLE_TRANSPORT_UART=n
CONFIG_ESP_HOSTED_ENABLE_BT_NIMBLE=y
CONFIG_ESP_HOSTED_NIMBLE_HCI_VHCI=y
# Hosted's task stacks in PSRAM: its tasks never touch flash.
CONFIG_ESP_HOSTED_DFLT_TASK_FROM_SPIRAM=y
CONFIG_ESP_PROTOCOMM_SUPPORT_SECURITY_VERSION_1=y
# Provisioning joins on the first match, on the channel the setup scan found;
# a full scan of both bands starves the BLE link that reports the join.
CONFIG_NETWORK_PROV_WIFI_STA_FAST_SCAN=y

CONFIG_WEBRTC_TRANSPORT_TASK_STACK=16384

# The Wi-Fi board carries SW2/SW3 beside the panel; they drive the local UI
# and the 16 px Montserrat face supplies its icons.
CONFIG_JETKVM_SCREEN_BUTTONS=y
CONFIG_LV_FONT_MONTSERRAT_16=y
