# One 48 kHz, stereo, 16-bit UAC2 sink. It follows the USB SOF clock;
# there is no independent DAC clock and therefore no feedback endpoint.
add_compile_definitions(
    CFG_TUD_AUDIO=1 CFG_TUD_AUDIO_FUNC_1_DESC_LEN=118
    CFG_TUD_AUDIO_FUNC_1_CTRL_BUF_SZ=64
    CFG_TUD_AUDIO_FUNC_1_MAX_SAMPLE_RATE=48000
    CFG_TUD_AUDIO_FUNC_1_N_CHANNELS_RX=2
    CFG_TUD_AUDIO_FUNC_1_N_BYTES_PER_SAMPLE_RX=2
    CFG_TUD_AUDIO_FUNC_1_RESOLUTION_RX=16
    CFG_TUD_AUDIO_ENABLE_EP_OUT=1
    CFG_TUD_AUDIO_FUNC_1_EP_OUT_SZ_MAX=196
    CFG_TUD_AUDIO_FUNC_1_EP_OUT_SW_BUF_SZ=8192)
