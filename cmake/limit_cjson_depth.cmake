# Network JSON is parsed on small stacks, including before login. Cap the
# nesting limit in cJSON's own and PUBLIC definitions, whatever the sdkconfig.
function(jetkvm_limit_cjson_depth target)
    foreach(property COMPILE_DEFINITIONS INTERFACE_COMPILE_DEFINITIONS)
        get_target_property(definitions ${target} ${property})
        if(NOT definitions)
            message(FATAL_ERROR "Missing cJSON definitions on ${target}")
        endif()
        set(found FALSE)
        set(capped_definitions "")
        foreach(definition IN LISTS definitions)
            if(definition MATCHES "^CJSON_NESTING_LIMIT=([0-9]+)$")
                set(found TRUE)
                if(CMAKE_MATCH_1 GREATER 16 OR CMAKE_MATCH_1 LESS 1)
                    set(definition "CJSON_NESTING_LIMIT=16")
                endif()
            endif()
            list(APPEND capped_definitions "${definition}")
        endforeach()
        if(NOT found)
            message(FATAL_ERROR "cJSON nesting definition changed; review stack limit")
        endif()
        set_property(TARGET ${target} PROPERTY ${property} "${capped_definitions}")
    endforeach()
endfunction()
